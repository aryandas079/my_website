---
import { getCollection, render } from 'astro:content';
import { ArrowLeft } from 'lucide-svelte';
import DashboardLayout from '../../layouts/DashboardLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('case-studies');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<DashboardLayout
  title={`${entry.data.title} — Aryan Das`}
  description={entry.data.summary}
>
  <div class="mx-auto max-w-4xl">
    <a
      href={`${import.meta.env.BASE_URL}#case-studies`}
      class="inline-flex items-center gap-1.5 font-mono text-xs font-medium text-[#8b949e] transition-colors hover:text-[#f75c7e]"
    >
      <ArrowLeft class="h-3.5 w-3.5 text-[#f75c7e]" aria-hidden="true" />
      <span>Back to 3D Portfolio</span>
    </a>

    <header class="mt-6 border-b border-[#262c36] pb-6">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-[#8b949e]">
        <span class="text-[#f75c7e]">{entry.data.facility}</span>
        <span aria-hidden="true">·</span>
        <span class="tabular-nums">{entry.data.publishedAt}</span>
        <span aria-hidden="true">·</span>
        <span>{entry.data.readTime}</span>
      </div>

      <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-balance text-[#e6edf3] sm:text-4xl">
        {entry.data.title}
      </h1>

      <p class="mt-3 text-base leading-relaxed text-[#8b949e]">
        {entry.data.summary}
      </p>
    </header>

    <!-- Frontmatter quantitative outcome strip -->
    <div class="mt-6 grid grid-cols-1 divide-y divide-[#262c36] rounded-xl border border-[#262c36] bg-[#161b22] sm:grid-cols-3 sm:divide-y-0 sm:divide-x">
      {entry.data.metrics.map((m) => (
        <div class="p-5">
          <div class="font-mono text-xs text-[#8b949e]">{m.label}</div>
          <div class="mt-1.5 font-mono text-2xl font-semibold text-[#f75c7e] tabular-nums">
            {m.value}
          </div>
          <div class="mt-1 text-xs text-[#8b949e]">{m.delta}</div>
        </div>
      ))}
    </div>

    <div class="mt-8 overflow-hidden rounded-xl border border-[#262c36] bg-[#161b22]">
      <img
        src={entry.data.coverImage}
        alt={entry.data.coverAlt}
        referrerpolicy="no-referrer"
        class="aspect-16/9 w-full object-cover"
      />
    </div>

    <!-- MDX Body Content in strict 2-dull + 1-bright palette -->
    <article
      class="mt-10 space-y-6 text-base leading-relaxed text-[#8b949e]
        [&_h2]:mt-10 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-[#e6edf3]
        [&_p]:leading-7
        [&_strong]:font-semibold [&_strong]:text-[#e6edf3]
        [&_code]:rounded [&_code]:border [&_code]:border-[#262c36] [&_code]:bg-[#161b22] [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-xs [&_code]:text-[#f75c7e]
        [&_table]:my-6 [&_table]:w-full [&_table]:border-collapse [&_table]:overflow-hidden [&_table]:rounded-lg [&_table]:border [&_table]:border-[#262c36]
        [&_thead]:bg-[#161b22]
        [&_th]:border-b [&_th]:border-[#262c36] [&_th]:px-4 [&_th]:py-2.5 [&_th]:text-left [&_th]:font-mono [&_th]:text-xs [&_th]:font-semibold [&_th]:text-[#e6edf3]
        [&_td]:border-b [&_td]:border-[#262c36] [&_td]:px-4 [&_td]:py-2.5 [&_td]:font-mono [&_td]:text-xs [&_td]:text-[#e6edf3] [&_td]:tabular-nums"
    >
      <Content />
    </article>
  </div>
</DashboardLayout>
