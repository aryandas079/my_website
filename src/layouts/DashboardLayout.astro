---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Aryan Das Portfolio',
  description = 'Minimal 3D hero experience for Aryan Das — Electrical Engineering Undergraduate at NIT Silchar, Full Stack Developer, and Machine Learning Explorer.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="light" style="color-scheme: light; background-color: #f5f5f2;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f5f5f2" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fraunces:opsz,wght,SOFT,WONK@9..144,700..800,100,1&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen min-h-[100dvh] bg-[var(--bg-dull)] text-[var(--ink-dull)] antialiased" style="color-scheme: light; background-color: #f5f5f2;">
    <main>
      <slot />
    </main>
  </body>
</html>
